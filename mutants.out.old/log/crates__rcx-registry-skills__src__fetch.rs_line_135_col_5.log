-    } else {
-        &entry.git_ref
-    };
-    format!(
-        "https://raw.githubusercontent.com/{}/{reference}/{}",
-        entry.source, entry.skill_path
-    )
+    String::new() /* ~ changed by cargo-mutants ~ */
 }
 
